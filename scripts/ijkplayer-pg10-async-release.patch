@@ -292,6 +292,24 @@ IjkMediaPlayer *IJKPlayerNapiProxy::set_media_player(std::string id, IjkMediaPla
     return GLOBAL_IJKMP[id];
 }
 
+IjkMediaPlayer *IJKPlayerNapiProxy::take_media_player(const std::string &id)
+{
+    std::lock_guard<std::mutex> lock(g_globalIjkmpMutex);
+    auto it = GLOBAL_IJKMP.find(id);
+    if (it == GLOBAL_IJKMP.end()) {
+        return nullptr;
+    }
+    IjkMediaPlayer *mp = it->second;
+    GLOBAL_IJKMP.erase(it);
+    return mp;
+}
+
+void IJKPlayerNapiProxy::restore_media_player(const std::string &id, IjkMediaPlayer *mp)
+{
+    std::lock_guard<std::mutex> lock(g_globalIjkmpMutex);
+    GLOBAL_IJKMP.emplace(id, mp);
+}
+
 void IJKPlayerNapiProxy::delete_media_player(std::string id)
