// 壁纸页（pages/main/ChatBackgroundPage）网格里的**一行**。
//
// 为什么是 @ObservedV2 + @Trace，而不是普通 interface + 父级 Map：
// 缩略图下载完成后，原来整表换掉 `thumbPaths: Map`（父级 @State），一次落盘就让
// ForEach 的项 builder 全部重算。v2sample 两轮独立小样实测：
//   - 整表替换 Map：24/24 项 builder 重算（改首行 / 中间行 / 末行结果一样）
//   - 每行 @Trace：0 次项 builder 重算，只有该行自己的 @Monitor 触发
//   - 两种写法父组件都不重建（parent-build 恒 1）
// 结论：热路径在父级 ForEach 的项重算上，不在子组件 build 里。所以把"缩略图到了"
// 这个事实下沉到行对象，观察范围就只剩那一格。
//
// 注意：V1 的 @Component 订阅不了这里的 @Trace（见 pages/chat/ChatHeader.ets
// 同一条约束 —— V1 组件既不能声明 @Param，也观察不到 @ObservedV2 上的 @Trace），
// 所以读 thumb / applying 的瓦片必须是 @ComponentV2。
import { TdObject } from '../tdkit/TdTypes';
import { BackgroundPreview } from './backgroundPresentation';

@ObservedV2
export class GalleryRow {
  // 颜色 / 图案 / 壁纸的展示数据。行对象一旦建好就不再改这两项 —— 列表重载时
  // 整行重建，用不着对它们做细粒度观察。
  preview: BackgroundPreview;
  raw: TdObject;

  // 每一行在**这一份列表**里的稳定唯一标识。
  //
  // 原来处处直接拿 preview.backgroundId 当身份，但 2026-11-06 真机跑出了
  // `Ids generated by the ForEach id gen function must be unique … Duplicated
  // index: [2,7,8]` —— 服务端返回的列表里确实存在 id 相同的多条记录。同一个
  // backgroundId 既当 ForEach 的 key，又当缩略图的键、又当 applyingId，
  // 三者一起串味：瓦片错位、缩略图互相顶替、选中高亮同时亮几格。
  //
  // 组成：`bg_<backgroundId>_<kind>_<isDark>` 打底（同一张背景在浅色/深色、
  // 图案/壁纸里是不同记录），若仍重名再追加出现序号 `#n`。**不用随机数或时间戳**：
  // 同一份列表重新加载时算出来的 key 完全一致；列表重排时 key 跟着记录走，
  // 只有"完全相同的重复记录"之间靠出现顺序区分 —— 它们本来就不可区分。
  key: string;

  // 缩略图的沙箱路径（'' = 还没下到）。下载完成由 scheduleThumbFlush 逐行写入，
  // 写一次只标脏这一格。
  @Trace thumb: string = '';

  // 应用壁纸时的转圈。它只是页面级互斥锁 `applyingId` 的**镜像**：
  // 闸门语义（同时只允许一个应用动作）仍在父级，这里只负责让"亮哪一格"能独立
  // 标脏 —— 高亮位跟着 applyingId 走的话，点一下就得让整张网格重算。
  @Trace applying: boolean = false;

  constructor(preview: BackgroundPreview, raw: TdObject, key: string) {
    this.preview = preview;
    this.raw = raw;
    this.key = key;
  }
}
